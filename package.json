{
  "name": "@sonparkserver/plugin-sdk",
  "private": false,
  "version": "0.11.0",
  "type": "module",
  "description": "Public SDK, CLI, and conformance tools for SPS plugins.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Powerpunch777/sps-plugin-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Powerpunch777/sps-plugin-sdk/issues"
  },
  "homepage": "https://github.com/Powerpunch777/sps-plugin-sdk#readme",
  "exports": {
    "./runtime": {
      "types": "./runtime/index.d.ts",
      "import": "./runtime/index.mjs",
      "default": "./runtime/index.mjs"
    },
    "./worker": {
      "types": "./worker/index.d.ts",
      "import": "./worker/index.mjs",
      "default": "./worker/index.mjs"
    },
    "./worker/testing": {
      "types": "./worker/testing.d.ts",
      "import": "./worker/testing.mjs",
      "default": "./worker/testing.mjs"
    },
    "./manifest": {
      "types": "./manifest/index.d.ts",
      "import": "./manifest/index.mjs",
      "default": "./manifest/index.mjs"
    },
    "./platform": {
      "types": "./platform/index.d.ts",
      "import": "./platform/index.mjs",
      "default": "./platform/index.mjs"
    },
    "./ui": {
      "types": "./ui/index.d.ts",
      "import": "./ui/index.mjs",
      "default": "./ui/index.mjs"
    },
    "./ui/bridge": {
      "types": "./ui/bridge.d.ts",
      "import": "./ui/bridge.mjs",
      "default": "./ui/bridge.mjs"
    },
    "./preview/fixtures-v1.mjs": {
      "types": "./preview/fixtures-v1.d.ts",
      "import": "./preview/fixtures-v1.mjs",
      "default": "./preview/fixtures-v1.mjs"
    },
    "./authoring/development-build-v1.mjs": {
      "types": "./authoring/development-build-v1.d.ts",
      "import": "./authoring/development-build-v1.mjs",
      "default": "./authoring/development-build-v1.mjs"
    },
    "./diagnostics/v1": {
      "types": "./diagnostics/v1.d.ts",
      "import": "./diagnostics/v1.mjs",
      "default": "./diagnostics/v1.mjs"
    },
    "./diagnostics/v1.mjs": {
      "types": "./diagnostics/v1.d.ts",
      "import": "./diagnostics/v1.mjs",
      "default": "./diagnostics/v1.mjs"
    },
    "./testing/v1": {
      "types": "./testing/v1.d.ts",
      "import": "./testing/v1.mjs",
      "default": "./testing/v1.mjs"
    },
    "./testing/v1.mjs": {
      "types": "./testing/v1.d.ts",
      "import": "./testing/v1.mjs",
      "default": "./testing/v1.mjs"
    },
    "./conformance/v1": {
      "types": "./conformance/v1.d.ts",
      "import": "./conformance/v1.mjs",
      "default": "./conformance/v1.mjs"
    },
    "./conformance/v1.mjs": {
      "types": "./conformance/v1.d.ts",
      "import": "./conformance/v1.mjs",
      "default": "./conformance/v1.mjs"
    },
    "./authoring/typed-contract-v1": {
      "types": "./authoring/typed-contract-v1.d.ts",
      "import": "./authoring/typed-contract-v1.mjs",
      "default": "./authoring/typed-contract-v1.mjs"
    },
    "./authoring/typed-contract-v1.mjs": {
      "types": "./authoring/typed-contract-v1.d.ts",
      "import": "./authoring/typed-contract-v1.mjs",
      "default": "./authoring/typed-contract-v1.mjs"
    },
    "./dependency/v1": {
      "types": "./dependency/v1.d.ts",
      "import": "./dependency/v1.mjs",
      "default": "./dependency/v1.mjs"
    },
    "./dependency/v1.mjs": {
      "types": "./dependency/v1.d.ts",
      "import": "./dependency/v1.mjs",
      "default": "./dependency/v1.mjs"
    },
    "./profile/*": "./profile/*",
    "./registry/*": "./registry/*",
    "./authoring/*": "./authoring/*"
  },
  "typesVersions": {
    "*": {
      "runtime": [
        "runtime/index.d.ts"
      ],
      "worker": [
        "worker/index.d.ts"
      ],
      "worker/testing": [
        "worker/testing.d.ts"
      ],
      "manifest": [
        "manifest/index.d.ts"
      ],
      "platform": [
        "platform/index.d.ts"
      ],
      "ui": [
        "ui/index.d.ts"
      ],
      "ui/bridge": [
        "ui/bridge.d.ts"
      ],
      "preview/fixtures-v1": [
        "preview/fixtures-v1.d.ts"
      ],
      "preview/fixtures-v1.mjs": [
        "preview/fixtures-v1.d.ts"
      ],
      "authoring/development-build-v1": [
        "authoring/development-build-v1.d.ts"
      ],
      "authoring/development-build-v1.mjs": [
        "authoring/development-build-v1.d.ts"
      ],
      "authoring/typed-contract-v1": [
        "authoring/typed-contract-v1.d.ts"
      ],
      "authoring/typed-contract-v1.mjs": [
        "authoring/typed-contract-v1.d.ts"
      ],
      "diagnostics/v1": [
        "diagnostics/v1.d.ts"
      ],
      "diagnostics/v1.mjs": [
        "diagnostics/v1.d.ts"
      ],
      "testing/v1": [
        "testing/v1.d.ts"
      ],
      "testing/v1.mjs": [
        "testing/v1.d.ts"
      ],
      "conformance/v1": [
        "conformance/v1.d.ts"
      ],
      "conformance/v1.mjs": [
        "conformance/v1.d.ts"
      ],
      "dependency/v1": [
        "dependency/v1.d.ts"
      ],
      "dependency/v1.mjs": [
        "dependency/v1.d.ts"
      ]
    }
  },
  "bin": {
    "sps-plugin": "./cli/sps-plugin.mjs"
  },
  "scripts": {
    "test": "node --test profile/extension-profile-v1.test.mjs profile/extension-profile-v2.test.mjs runtime/index.test.mjs runtime/host-support.test.mjs runtime/consumer-smoke.test.mjs worker/index.test.mjs worker/testing.test.mjs worker/consumer-smoke.test.mjs manifest/index.test.mjs platform/index.test.mjs ui/index.test.mjs ui/bridge.test.mjs preview/fixtures-v1.test.mjs diagnostics/v1.test.mjs testing/v1.test.mjs testing/consumer-smoke.test.mjs conformance/v1.test.mjs dependency/v1.test.mjs dependency/consumer-smoke.test.mjs registry/release-record-v1.test.mjs registry/local-registry-v1.test.mjs registry/archive-inspector-v1.test.mjs registry/source-trust-v1.test.mjs registry/package-extractor-v1.test.mjs registry/static-package-manifest-v1.test.mjs authoring/worker-bundle-v1.test.mjs authoring/plugin-package-v1.test.mjs authoring/development-build-v1.test.mjs authoring/development-build-v1.consumer-smoke.test.mjs authoring/typed-contract-v1.test.mjs cli/sps-plugin.test.mjs templates/github-static-registry-publish.test.mjs",
    "test:diagnostics": "node --test diagnostics/v1.test.mjs testing/v1.test.mjs conformance/v1.test.mjs testing/consumer-smoke.test.mjs",
    "check": "npm run test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "esbuild": "0.25.8",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "typescript": "5.7.3"
  }
}
